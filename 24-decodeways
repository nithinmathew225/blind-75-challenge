class Solution:
    def numDecodings(self, s: str) -> int:
        if not s:
            return 0
        
        # dp[i] represents the number of ways to decode s[0:i]
        n = len(s)
        dp = [0] * (n + 1)
        
        # Base case: There's one way to decode an empty string
        dp[0] = 1
        
        # If the first character is not '0', there is one way to decode the first character
        dp[1] = 1 if s[0] != '0' else 0
        
        for i in range(2, n + 1):
            # Check the single digit (s[i-1])
            if s[i-1] != '0':
                dp[i] += dp[i-1]
            
            # Check the two digits (s[i-2:i])
            two_digit = int(s[i-2:i])
            if 10 <= two_digit <= 26:
                dp[i] += dp[i-2]
        
        return dp[n]
