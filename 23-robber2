class Solution:
    def rob(self, nums: List[int]) -> int:
        def house_robber(nums):
            n = len(nums)
            if n == 0:
                return 0
            if n == 1:
                return nums[0]
            
            # dp[i] will be the max money robbed up to the i-th house
            dp = [0] * n
            dp[0] = nums[0]
            dp[1] = max(nums[0], nums[1])
            
            for i in range(2, n):
                dp[i] = max(dp[i-1], dp[i-2] + nums[i])
            
            return dp[-1]
        
        n = len(nums)
        
        # If there's only one house, return its value
        if n == 1:
            return nums[0]
        
        # Case 1: Rob houses from 0 to n-2 (exclude the last house)
        case1 = house_robber(nums[:-1])
        
        # Case 2: Rob houses from 1 to n-1 (exclude the first house)
        case2 = house_robber(nums[1:])
        
        # Return the maximum of both cases
        return max(case1, case2)
