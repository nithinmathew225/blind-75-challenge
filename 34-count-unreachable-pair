class Solution:
    def countPairs(self, n: int, edges: List[List[int]]) -> int:
        adj = collections.defaultdict(list)
        for u, v in edges:
            adj[u].append(v)
            adj[v].append(u)

        # 2. Track Visited Nodes
        visited = [False] * n
        component_sizes = []

        # 3. Iterate and Traverse to find component sizes
        for i in range(n):
            if not visited[i]:
                current_component_size = 0
                q = collections.deque([i])
                visited[i] = True

                while q:
                    u = q.popleft()
                    current_component_size += 1
                    for v in adj[u]:
                        if not visited[v]:
                            visited[v] = True
                            q.append(v)

                component_sizes.append(current_component_size)

        # 4. Calculate Unreachable Pairs using Method 1 (Total - Reachable)
        total_possible_pairs = n * (n - 1) // 2
        total_reachable_pairs = 0
        for size in component_sizes:
            total_reachable_pairs += size * (size - 1) // 2

        unreachable_pairs = total_possible_pairs - total_reachable_pairs
        return unreachable_pairs
        
