class Solution:
    def leftmostBuildingQueries(self, heights: List[int], queries: List[List[int]]) -> List[int]:
        n = len(heights)
        q = len(queries)
        ans = [-1] * q  
        
        next_greater = [-1] * n
        stack = []  
        for i in range(n - 1, -1, -1):  
            while stack and heights[stack[-1]] <= heights[i]:
                stack.pop()
            
            if stack:
                next_greater[i] = stack[-1]
            
            stack.append(i)

        
        MAX_P = n.bit_length() 
        
        
        jump = [[-1] * n for _ in range(MAX_P)]

        # Base case: p=0 corresponds to 1 jump (i.e., the direct next_greater)
        for i in range(n):
            jump[0][i] = next_greater[i]

        # Build the jump table using dynamic programming
        for p in range(1, MAX_P):
            for i in range(n):
                # Where do we land after 2^(p-1) jumps from i?
                intermediate_node = jump[p-1][i]
                # If the first 2^(p-1) jump sequence is valid (doesn't lead to -1),
                # then make the next 2^(p-1) jump from the intermediate node.
                if intermediate_node != -1:
                    jump[p][i] = jump[p-1][intermediate_node]
                # Otherwise, the jump sequence of length 2^p is also invalid (-1)

        # --- 3. Process Each Query ---
        for i in range(q):
            a, b = queries[i]

            # Handle trivial case: Alice and Bob start at the same building
            if a == b:
                ans[i] = a
                continue

            # Ensure 'a' is the index of the leftmost person for consistency
            if a > b:
                a, b = b, a  
            if heights[a] < heights[b]:
                ans[i] = b
                continue
            target_h = max(heights[a], heights[b])
            
            current_node = b 
            if heights[current_node] <= target_h:
                for p in range(MAX_P - 1, -1, -1): 
                    next_node_candidate = jump[p][current_node]
                    if next_node_candidate != -1 and heights[next_node_candidate] <= target_h:
                        current_node = next_node_candidate 
            
            
            
            final_answer_node = next_greater[current_node] 
            ans[i] = final_answer_node 

        return ans
